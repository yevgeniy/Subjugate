<?xml version="1.0" encoding="utf-8" ?>
<Defs>
   <HediffDef ParentName="Subj_ApparelBase_Hediff">
      <defName>Subj_Bindings_Hediff</defName>
      <label>restrictive bindings</label>
      <description>Tight bindings making it hard to move around</description>
      <isBad>false</isBad>
      <hediffClass>Subjugate.Hediff_Binders</hediffClass>
      <initialSeverity>0.01</initialSeverity>
      <maxSeverity>1</maxSeverity>
      <!-- <comps>
         <li Class="HediffCompProperties_SeverityPerDay">
            <severityPerDay>0.10</severityPerDay>
         </li>
      </comps> -->
      <stages>
         <li>
            <minSeverity>0.01</minSeverity>
            <label>This thing is tight</label>
            <painOffset>0.1</painOffset>
            <capMods>
               <li>
                  <capacity>Manipulation</capacity>
                  <offset>-0.2</offset>
               </li>
               <li>
                  <capacity>Moving</capacity>
                  <offset>-0.4</offset>
               </li>
            </capMods>
         </li>
         <li>
            <minSeverity>1</minSeverity>
            <label>Draged down!</label>
            <painOffset>0.1</painOffset>
            <capMods>
               <li>
                  <capacity>Manipulation</capacity>
                  <offset>-1</offset>
               </li>
               <li>
                  <capacity>Moving</capacity>
                  <offset>-1</offset>
               </li>
            </capMods>
         </li>
      </stages>
   </HediffDef>

</Defs>