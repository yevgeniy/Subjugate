<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef Name="Subj_SlaveDress_Item" ParentName="Subj_Dress_Base">
    <defName>Subj_SlaveDress_Item</defName>
    <label>servant girl dress</label>
    <description>Revealing dress usually seen on low rank sex-slaves.</description>
    <graphicData>
      <texPath>Things/Apparel/Dress/ServantA/S16Dress1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <tradeability>All</tradeability>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <statBases>
      <WorkToMake>10000</WorkToMake>
      <Mass>0.5</Mass>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Subj_SlaveGirl_ThingCategory</li>
    </thingCategories>
    <equippedStatOffsets>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.2</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Legs</li>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/Dress/ServantA/S16Dress1</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Subj_Dress</li>
        <li>Subj_Tier1</li>
      </tags>
      <gender>Female</gender>
    </apparel>
    <comps>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
    
  </ThingDef>

